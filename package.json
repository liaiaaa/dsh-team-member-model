{
  "name": "dsh-team-member-model",
  "version": "2.3.0",
  "description": "dsh 插件：为团队模式（Agent Teams）的每个子队友单独指定模型，或跟随主对话当前模型切换（per-teammate model pin / follow；适配 dsh 0.2.2-rc.3）",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liaiaaa/dsh-team-member-model.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "agent-teams",
    "teammate",
    "model-selection"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "icon": "icon.svg"
}
